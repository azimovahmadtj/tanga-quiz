rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // An admin is any account whose UID has a document in /admins (created by hand in the console)
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- validation helpers: the server rejects anything the site itself would never write ----
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function optInt(d, k, lo, hi) { return !(k in d) || (d[k] is int && d[k] >= lo && d[k] <= hi); }
    function optList(d, k, max) { return !(k in d) || (d[k] is list && d[k].size() <= max); }
    function optMap(d, k, max) { return !(k in d) || (d[k] is map && d[k].size() <= max); }

    // Player progress written by the player's own browser
    function validScore(d) {
      return d.keys().hasOnly(['nick', 'nickLower', 'avatar', 'period', 'coins', 'answered', 'day',
                               'dayCount', 'dayCoins', 'totalAnswered', 'totalCorrect', 'days',
                               'activity', 'wrong', 'hist', 'quizDone', 'lastTopic', 'lastQuiz', 'updatedAt',
                               'srvAt', 'dayStart'])
        // nickname: 3–20 letters, digits or _ (same rule as the site), stored lower-cased for uniqueness
        // (rules' lower() only handles Latin letters, so check the lower-cased copy has no capitals instead)
        && (!('nick' in d) || (d.nick is string && d.nick.matches('^[\\p{L}\\p{N}_]{3,20}$')
                               && d.nickLower is string && d.nickLower.size() == d.nick.size()
                               && d.nickLower.matches('^[\\p{Ll}\\p{Lo}\\p{Lm}\\p{N}_]{3,20}$')))
        // avatar: only an inline JPEG/PNG/WebP picture (no links to other sites), at most ~30 KB
        && (!('avatar' in d) || d.avatar == ''
            || (d.avatar is string && d.avatar.size() <= 40000
                && d.avatar.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')))
        && optInt(d, 'period', -100000, 100000)
        && optInt(d, 'coins', 0, 10000000)
        && optInt(d, 'dayCount', 0, 100000)
        && optInt(d, 'dayCoins', 0, 10000000)
        && optInt(d, 'totalAnswered', 0, 100000000)
        && optInt(d, 'totalCorrect', 0, 100000000)
        && optInt(d, 'updatedAt', 0, 9999999999999)
        && optStr(d, 'day', 10)
        && optStr(d, 'lastTopic', 100)
        && optStr(d, 'lastQuiz', 100)
        && optList(d, 'answered', 3000)
        && optList(d, 'days', 120)
        && optList(d, 'activity', 8)
        && optList(d, 'wrong', 60)
        && optMap(d, 'hist', 61)
        && optMap(d, 'quizDone', 200);
    }


    // ---- anti-cheat: progress can only grow the way the game grows it ----
    // Settings from the admin panel (config/rules), with the same defaults as the site code
    function cfgVal(k, dflt) {
      return exists(/databases/$(database)/documents/config/rules)
        ? get(/databases/$(database)/documents/config/rules).data.get(k, dflt) : dflt;
    }
    function curPeriod() {
      return cfgVal('base', 0) + math.floor((request.time.toMillis() - cfgVal('epoch', 1790553600000))
                                             / (cfgVal('roundDays', 14) * 86400000.0));
    }
    function num(d, k) { return d.get(k, 0); }
    function quizList(d, q) { return d.get('quizDone', {}).get(q, []); }
    // An answer inside an active quiz: one more question of that quiz, within its question count
    function isQuizAnswer(n, o) {
      return 'lastQuiz' in n && n.lastQuiz is string
        && quizList(n, n.lastQuiz).size() == quizList(o, n.lastQuiz).size() + 1
        && exists(/databases/$(database)/documents/quizzes/$(n.lastQuiz))
        && quizOk(get(/databases/$(database)/documents/quizzes/$(n.lastQuiz)).data, quizList(n, n.lastQuiz).size());
    }
    function quizOk(q, done) {
      return request.time.toMillis() >= q.start && request.time.toMillis() <= q.end && done <= q.qids.size();
    }
    function quizBonus(n) { return get(/databases/$(database)/documents/quizzes/$(n.lastQuiz)).data.bonus; }
    // The daily counter only goes up by one, and restarts at most every 12 hours (server clock)
    function dayCountOk(n, o) {
      return (num(n, 'dayCount') == num(o, 'dayCount') + 1
              && n.get('dayStart', null) == o.get('dayStart', null))
          || (num(n, 'dayCount') == 1 && n.get('dayStart', null) == request.time
              && (!('dayStart' in o) || request.time > o.dayStart + duration.value(12, 'h')));
    }
    function progressOk(n, o) {
      let dA = num(n, 'totalAnswered') - num(o, 'totalAnswered');
      let dC = num(n, 'totalCorrect') - num(o, 'totalCorrect');
      let quiz = dA == 1 && isQuizAnswer(n, o);
      let regular = dA == 1 && !quiz;
      let maxGain = dC == 0 ? 0 : (quiz ? quizBonus(n) : cfgVal('coinsPerRight', 10));
      let samePeriod = n.get('period', 0) == o.get('period', n.get('period', 0));
      return (dA == 0 || dA == 1) && dC >= 0 && dC <= dA
        && (n.get('period', 0) == curPeriod() || n.get('period', 0) == curPeriod() - 1)
        && (samePeriod ? num(n, 'coins') - num(o, 'coins') <= maxGain : num(n, 'coins') <= maxGain)
        && (regular ? dayCountOk(n, o) && num(n, 'dayCount') <= cfgVal('dailyLimit', 30)
                    : num(n, 'dayCount') == num(o, 'dayCount') && n.get('dayStart', null) == o.get('dayStart', null));
    }
    // At most one progress write per second (time comes from the server, not the browser)
    function rateOk(n, o) {
      return n.srvAt == request.time && (!('srvAt' in o) || request.time > o.srvAt + duration.value(1, 's'));
    }
    // A new player starts from zero
    function freshOk(n) {
      return num(n, 'coins') == 0 && num(n, 'totalAnswered') == 0 && num(n, 'totalCorrect') == 0
        && num(n, 'dayCount') == 0 && n.srvAt == request.time && !('dayStart' in n);
    }
    // A nickname in scores must be reserved for this player in /nicks
    function ownsNick(uid, d) {
      return !('nick' in d)
        || getAfter(/databases/$(database)/documents/nicks/$(d.nickLower)).data.uid == uid;
    }

    // Private contact details written by the player's own browser
    function validContact(d) {
      return d.keys().hasOnly(['name', 'email', 'phone', 'agreedAt', 'createdAt', 'updatedAt'])
        && optStr(d, 'name', 60)
        && optStr(d, 'email', 100)
        && optStr(d, 'phone', 30)
        && optInt(d, 'agreedAt', 0, 9999999999999)
        && optInt(d, 'createdAt', 0, 9999999999999)
        && optInt(d, 'updatedAt', 0, 9999999999999);
    }

    // List of admins: nobody can write it from the site; each admin can only see their own entry
    match /admins/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // Content managed only by the admin, readable by everyone
    match /questions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /quizzes/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /config/{id}    { allow read: if true; allow write: if isAdmin(); }

    // Player progress: public (leaderboard), each player edits only their own, with validated fields
    match /scores/{uid} {
      allow read: if true;
      allow create: if isAdmin() || (isSelf(uid) && validScore(request.resource.data)
                                     && freshOk(request.resource.data) && ownsNick(uid, request.resource.data));
      allow update: if isAdmin() || (isSelf(uid) && validScore(request.resource.data)
                                     && rateOk(request.resource.data, resource.data)
                                     && progressOk(request.resource.data, resource.data)
                                     && ownsNick(uid, request.resource.data));
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Nickname reservations: one owner per (lower-case) nickname, so nobody can take someone else's name
    match /nicks/{nick} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid
                    && nick.matches('^[\\p{Ll}\\p{Lo}\\p{Lm}\\p{N}_]{3,20}$')
                    && getAfter(/databases/$(database)/documents/scores/$(request.auth.uid)).data.get('nickLower', '') == nick;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Private contact details: only the player and the admin
    match /contacts/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isAdmin() || (isSelf(uid) && validContact(request.resource.data));
      allow delete: if isSelf(uid) || isAdmin();
    }
  }
}
